CTR_GO_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
CTR_GO_ALLOWED_USER_IDS=<telegram-user-id>
# Exact private forum supergroup used only by AFC. Leave unset to disable AFC.
CTR_GO_AFC_GROUP_ID=<telegram-forum-supergroup-id>
# Number of recent Codex chats materialized by /afc on; later chats sync continuously.
CTR_GO_AFC_INITIAL_TOPIC_LIMIT=5
CTR_GO_DEFAULT_CWD=C:\Users\you\Projects\Codex
# Use daemon only when Codex Desktop and codex-tg share one managed local App Server.
CTR_GO_APP_SERVER_MODE=spawned
# CTR_GO_APP_SERVER_SOCKET=/absolute/path/to/app-server-control.sock
CTR_GO_PROJECTS_PROJECT_PREVIEW_LIMIT=7
CTR_GO_PROJECTS_CHAT_PREVIEW_LIMIT=3
CTR_GO_CHATS_PAGE_SIZE=8

# Optional screenshot demo.
CTR_DEMO_TELEGRAM_E2E=0
CTR_DEMO_TELEGRAM_CHAT_ID=<telegram-chat-id>
CTR_DEMO_KEEP_MESSAGES=false

CTR_GO_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
CTR_GO_ALLOWED_USER_IDS=<telegram-user-id>
# Exact private forum supergroup used only by AFC. Leave unset to disable AFC.
CTR_GO_AFC_GROUP_ID=<telegram-forum-supergroup-id>
# Number of recent Codex chats materialized by /afc on; later chats sync continuously.
CTR_GO_AFC_INITIAL_TOPIC_LIMIT=5

# Optional Yandex Messenger -> Telegram approval -> Codex launch requests.
# Create the permanent Telegram forum topic manually; codex-tg never deletes it.
CTR_GO_YMESSENGER_ENABLED=false
# CTR_GO_YMESSENGER_ROBOT_LOGIN=<robot-login>
# CTR_GO_YMESSENGER_OAUTH_TEAM_TOKEN=<robot-oauth-team-token>
# CTR_GO_YMESSENGER_ALLOWED_SENDERS=<sender-login>
# CTR_GO_YMESSENGER_POLL_SECONDS=2
# CTR_GO_YMESSENGER_REQUIRE_APPROVAL=true
# CTR_GO_EXTERNAL_REQUESTS_TOPIC_ID=<permanent-requests-topic-id>
# CTR_GO_EXTERNAL_REQUEST_DEFAULT_CWD=C:\Users\you\Projects\Codex
# Optional explicit App Server permissions for external sessions; empty values inherit Codex defaults.
# CTR_GO_EXTERNAL_REQUEST_APPROVAL_POLICY=never
# CTR_GO_EXTERNAL_REQUEST_APPROVALS_REVIEWER=auto_review
# CTR_GO_EXTERNAL_REQUEST_SANDBOX_MODE=danger-full-access

# Optional Arcanum assigned-review -> Telegram approval -> arc-pr-review launch requests.
# Uses the existing authenticated gena-arcanum-cli; no additional OAuth token is stored.
CTR_GO_ARCANUM_REVIEW_ENABLED=false
# CTR_GO_ARCANUM_REVIEW_LOGIN=<reviewer-login>
# CTR_GO_ARCANUM_YA_BIN=/absolute/path/to/ya
# CTR_GO_ARCANUM_REVIEW_POLL_SECONDS=60
# CTR_GO_ARCANUM_REVIEW_CWD=/absolute/path/to/projects
# Optional exact author-login allowlist; matching future PRs auto-start only after their card is visible.
# CTR_GO_ARCANUM_REVIEW_AUTO_START_AUTHORS=alice,bob

CTR_GO_DEFAULT_CWD=C:\Users\you\Projects\Codex
# Use daemon only when Codex Desktop and codex-tg share one managed local App Server.
CTR_GO_APP_SERVER_MODE=spawned
# CTR_GO_APP_SERVER_SOCKET=/absolute/path/to/app-server-control.sock
# Or connect both clients to one standalone loopback WebSocket App Server.
# CTR_GO_APP_SERVER_MODE=websocket
# CTR_GO_APP_SERVER_LISTEN=ws://127.0.0.1:4500
CTR_GO_PROJECTS_PROJECT_PREVIEW_LIMIT=7
CTR_GO_PROJECTS_CHAT_PREVIEW_LIMIT=3
CTR_GO_CHATS_PAGE_SIZE=8

# Optional screenshot demo.
CTR_DEMO_TELEGRAM_E2E=0
CTR_DEMO_TELEGRAM_CHAT_ID=<telegram-chat-id>
CTR_DEMO_KEEP_MESSAGES=false
